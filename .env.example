# ============================================================================
# FindMyWorker Backend - Environment variables
# Copy to ".env" and fill in. NEVER commit the real .env (it is gitignored).
# ============================================================================

# --- Core Django ---
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-in-production
DEBUG=True
# Comma-separated. In production add your Render host / custom domain.
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# --- Database (PostgreSQL + PostGIS) ---
# Option A (recommended for Supabase/Render): a single connection string.
# Supabase requires the PostGIS extension: run `create extension if not exists postgis;`
# Use the DIRECT connection (port 5432), not the transaction pooler (6543), for migrations/GIS.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=

# Option B: discrete vars (used only when DATABASE_URL is empty).
DB_NAME=findmyworker_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
# Persistent connection lifetime (seconds). 0 disables connection reuse.
DB_CONN_MAX_AGE=600
# Require SSL to the DB. Defaults to "not DEBUG" when unset.
# DB_SSL_REQUIRE=True

# --- Redis (Channels transport + cache) ---
# Option A: a single URL for managed Redis (Render Key Value, Upstash, ...).
# Supports auth and TLS, e.g. rediss://default:PASSWORD@host:6379
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=
# Option B: host/port (used only when REDIS_URL is empty).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- CORS / CSRF ---
# Frontend origins allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Trusted origins for CSRF (must include scheme). Needed for the Django admin
# behind an HTTPS proxy in production, e.g. https://your-app.onrender.com
CSRF_TRUSTED_ORIGINS=

# --- HTTPS (only applied when DEBUG=False) ---
# Set to False only if you terminate TLS elsewhere and must avoid the redirect.
# SECURE_SSL_REDIRECT=True

# ============================================================================
# AWS S3 (HU4 media storage). Only read when USE_S3=True.
# ============================================================================
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
# Optional: override the public domain (e.g. a CloudFront distribution).
# Defaults to {bucket}.s3.{region}.amazonaws.com
# AWS_S3_CUSTOM_DOMAIN=
